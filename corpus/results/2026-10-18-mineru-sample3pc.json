{
 "about": {
  "tool": "MinerU 4.0.12 (pip mineru==4.0.12, docvortex 0.5.16)",
  "mineru_basic": "tier=basic (the 4.x successor of the 'pipeline' backend: PP-DocLayoutV2 layout + OCR/formula/table small models, Torch on MPS), ocr_mode=auto, llm_aided.title_leveling off (default)",
  "mineru_standard": "tier=standard on 3 docs: small-model layout (PP-DocLayoutV2) + MinerU2.5-Pro-2605-1.2B GGUF (llama.cpp, Metal) for block content only; its titles were identical to basic on all 3 docs",
  "mineru_advanced_vlm": "tier=advanced on 3 docs: the VLM does layout + content (two-step extraction, the 4.x equivalent of the 2.x 'vlm' backend); doc_title vs paragraph_title split via the layout model; ocr_mode=auto",
  "conversion": "content_list V1 items with text_level -> {title: text, number: '', level: text_level, page_start: page_idx + 1}",
  "summary_rule": "P and F1 average complete-gold docs; R averages all docs with gold; levels average docs with a defined level_agreement",
  "raw_output": "<workspace>/.tmp/mineru-out",
  "machine": "MacBook M4 16 GB, one document at a time; seconds include model load on the first document"
 },
